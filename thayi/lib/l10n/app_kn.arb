  "topicFood": "ಆಹಾರ",
  "topicRest": "ವಿಶ್ರಾಂತಿ ಮತ್ತು ಕೆಲಸ",
  "topicAfterDelivery": "ಹೆರಿಗೆಯ ನಂತರ",

  "qFood1": "ಪ್ರತಿ ದಿನ ಏನು ತಿನ್ನಬೇಕು?",
  "aFood1": "ಪ್ರತಿ ದಿನ ಎಲ್ಲಾ ಬಗೆಯ ಆಹಾರ ಸ್ವಲ್ಪ ಸ್ವಲ್ಪ ತಿನ್ನಿ: ಅನ್ನ ಅಥವಾ ರಾಗಿ, ಬೇಳೆ ಅಥವಾ ಮೊಟ್ಟೆ, ಮತ್ತು ಸೊಪ್ಪು ತರಕಾರಿ. ಸ್ವಲ್ಪ ಬೆಲ್ಲ ಮತ್ತು ಶೇಂಗಾ ಸೇರಿಸಿ. ಆಗಾಗ ನೀರು ಕುಡಿಯಿರಿ. ಕಬ್ಬಿಣಾಂಶದ ಮಾತ್ರೆಯನ್ನು ಊಟದ ನಂತರ ತೆಗೆದುಕೊಳ್ಳಿ.",
  "qFood2": "ಚಹಾ ಕಾಫಿ ಕುಡಿಯಬಹುದೇ?",
  "aFood2": "ಸ್ವಲ್ಪ ಪರವಾಗಿಲ್ಲ. ಆದರೆ ಕಬ್ಬಿಣಾಂಶದ ಮಾತ್ರೆಯ ಜೊತೆಗೇ ಬೇಡ — ಅದು ಮಾತ್ರೆ ಕೆಲಸ ಮಾಡದಂತೆ ಮಾಡುತ್ತದೆ. ನಡುವೆ ಒಂದು ಗಂಟೆ ಅಂತರ ಇರಲಿ. ಹಾಲು, ಮಜ್ಜಿಗೆ ಮತ್ತು ನೀರು ಹೆಚ್ಚು ಒಳ್ಳೆಯದು.",
  "qFood3": "ಬೆಳಿಗ್ಗೆ ವಾಕರಿಕೆ ಆಗುತ್ತದೆ. ಏನು ಮಾಡಲಿ?",
  "aFood3": "ಮೂರು ದೊಡ್ಡ ಊಟದ ಬದಲು ಸ್ವಲ್ಪ ಸ್ವಲ್ಪವಾಗಿ ಹೆಚ್ಚು ಸಲ ತಿನ್ನಿ. ಹಾಸಿಗೆಯಿಂದ ಏಳುವ ಮೊದಲು ಮಂಡಕ್ಕಿ ಅಥವಾ ಬಿಸ್ಕತ್ತು ತಿಂದರೆ ಸಹಾಯ ಆಗುತ್ತದೆ. ಒಂದು ದಿನ ಪೂರ್ತಿ ಊಟ ನೀರು ಏನೂ ಒಳಗೆ ಉಳಿಯದಿದ್ದರೆ ಆಶಾ ಕಾರ್ಯಕರ್ತೆಗೆ ಹೇಳಿ.",

  "qRest1": "ಎಷ್ಟು ವಿಶ್ರಾಂತಿ ತೆಗೆದುಕೊಳ್ಳಬೇಕು?",
  "aRest1": "ಹಗಲಿನಲ್ಲಿ ಎರಡು ಗಂಟೆ ವಿಶ್ರಾಂತಿ ತೆಗೆದುಕೊಳ್ಳಿ, ಎಡ ಮಗ್ಗುಲಲ್ಲಿ ಮಲಗಿ. ರಾತ್ರಿ ಚೆನ್ನಾಗಿ ನಿದ್ದೆ ಮಾಡಿ. ಕೊನೆಯ ಮೂರು ತಿಂಗಳಲ್ಲಿ ದೇಹಕ್ಕೆ ಎಂದಿಗಿಂತ ಹೆಚ್ಚು ವಿಶ್ರಾಂತಿ ಬೇಕು.",
  "qRest2": "ಮನೆ ಕೆಲಸ ಮಾಡಬಹುದೇ?",
  "aRest2": "ಹಗುರವಾದ ಕೆಲಸ ಒಳ್ಳೆಯದು. ಭಾರವಾದ ಪಾತ್ರೆ ಅಥವಾ ನೀರು ಎತ್ತುವುದು, ಗಂಟೆಗಟ್ಟಲೆ ನಿಲ್ಲುವುದು ಮತ್ತು ಹತ್ತುವುದು ಬೇಡ. ತಲೆ ಸುತ್ತಿದರೆ ಅಥವಾ ಹೊಟ್ಟೆ ಬಿಗಿಯಾದರೆ ನಿಲ್ಲಿಸಿ ಕುಳಿತುಕೊಳ್ಳಿ.",
  "qRest3": "ತವರು ಮನೆಗೆ ಪ್ರಯಾಣ ಮಾಡಬಹುದೇ?",
  "aRest3": "ಎಂಟನೇ ತಿಂಗಳವರೆಗೆ ಚಿಕ್ಕ ಪ್ರಯಾಣ ಸಾಮಾನ್ಯವಾಗಿ ಪರವಾಗಿಲ್ಲ. ಹೆರಿಗೆ ದಿನ ಹತ್ತಿರ ಬಂದಾಗ ಉದ್ದದ ಕುಲುಕುವ ರಸ್ತೆ ಪ್ರಯಾಣ ಬೇಡ. ಎಲ್ಲಿಗೆ ಹೋದರೂ ತಾಯಿ ಕಾರ್ಡ್ ಜೊತೆಗೆ ಇರಲಿ.",

  "qAfter1": "ಮಗುವಿಗೆ ಯಾವಾಗ ಹಾಲುಣಿಸಬೇಕು?",
  "aAfter1": "ಹುಟ್ಟಿದ ಒಂದು ಗಂಟೆಯ ಒಳಗೆ ಹಾಲುಣಿಸಿ. ಮೊದಲ ದಪ್ಪ ಹಳದಿ ಹಾಲು ತುಂಬಾ ಮುಖ್ಯ — ಅದನ್ನು ಚೆಲ್ಲಬೇಡಿ. ಆರು ತಿಂಗಳವರೆಗೆ ಎದೆ ಹಾಲು ಮಾತ್ರ ಕೊಡಿ, ನೀರು ಜೇನುತುಪ್ಪ ಏನೂ ಬೇಡ.",
  "qAfter2": "ಹೆರಿಗೆಯ ನಂತರ ಎಷ್ಟು ದಿನ ವಿಶ್ರಾಂತಿ ಬೇಕು?",
  "aAfter2": "ಆರು ವಾರ ಪೂರ್ತಿ ವಿಶ್ರಾಂತಿ ತೆಗೆದುಕೊಳ್ಳಿ. ಚೆನ್ನಾಗಿ ಊಟ ಮಾಡಿ, ನೀರು ಕುಡಿಯುತ್ತಿರಿ. ಈ ಸಮಯದಲ್ಲಿ ಆಶಾ ಕಾರ್ಯಕರ್ತೆ ಹಲವು ಸಲ ಮನೆಗೆ ಬಂದು ನೋಡುತ್ತಾರೆ.",
  "qAfter3": "ಮಗುವಿಗೆ ಮೊದಲ ಲಸಿಕೆ ಯಾವಾಗ?",
  "aAfter3": "ಮೊದಲ ಲಸಿಕೆಗಳನ್ನು ಹುಟ್ಟಿದಾಗಲೇ ಆಸ್ಪತ್ರೆಯಲ್ಲಿ ಹಾಕುತ್ತಾರೆ. ಮುಂದಿನವು ಆರು ವಾರಕ್ಕೆ. ಲಸಿಕೆ ಕಾರ್ಡ್ ಜೋಪಾನವಾಗಿ ಇಟ್ಟುಕೊಳ್ಳಿ, ಪ್ರತಿ ಸಲ ತೆಗೆದುಕೊಂಡು ಹೋಗಿ.",

  "aFallback": "ಇದಕ್ಕೆ ಸರಿಯಾದ ಉತ್ತರ ನನಗೆ ಗೊತ್ತಿಲ್ಲ. ನಿಮ್ಮ ಆಶಾ ಕಾರ್ಯಕರ್ತೆಗೆ ಗೊತ್ತಿರುತ್ತದೆ — ಈ ಪ್ರಶ್ನೆಯನ್ನು ಅವರಿಗೆ ತಲುಪಿಸಲೇ?",
  "aMedicineRefusal": "ಔಷಧಿ ಅಥವಾ ಮಾತ್ರೆಯ ಪ್ರಮಾಣದ ಬಗ್ಗೆ ನಾನು ಸಲಹೆ ಕೊಡುವುದಿಲ್ಲ. ನಿಮ್ಮ ಆಶಾ ಕಾರ್ಯಕರ್ತೆ ಅಥವಾ ಆರೋಗ್ಯ ಕೇಂದ್ರದ ವೈದ್ಯರನ್ನು ಕೇಳಿ — ನಿಮ್ಮ ದಾಖಲೆ ಅವರಿಗೆ ಗೊತ್ತು.",
  "contactAshaFromChat": "ಇದನ್ನು ನನ್ನ ಆಶಾಗೆ ಕಳುಹಿಸಿ",
